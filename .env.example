POSTGRES_DB=voxflow
POSTGRES_USER=voxflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://username:password@host:5432/database
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MODEL_SIZE=base
DEVICE=cpu
COMPUTE_TYPE=int8
DEFAULT_LANGUAGE=en
ENABLE_LANGUAGE_DETECTION=true
AUDIO_WINDOW_SECONDS=3
AUDIO_OVERLAP_SECONDS=0.75
WEBSOCKET_MAX_CHUNK_BYTES=262144
WEBSOCKET_MAX_SESSION_SECONDS=3600
WEBSOCKET_IDLE_TIMEOUT_SECONDS=60
WEBSOCKET_START_TIMEOUT_SECONDS=15
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_WS_URL=ws://127.0.0.1:8000/ws/transcription
